# Backend API Base URL (leave empty for simulated client-rendered frames, or set to Render URL without trailing slash)
# Example for production: https://argus-backend.onrender.com
# Example for local development: http://localhost:8000
VITE_API_BASE=

# Allow live fetching of non-cached survey data from NASA/IRSA (false by default, true only on demo laptop)
VITE_ALLOW_LIVE_FETCH=false
